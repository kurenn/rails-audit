#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/scan-secrets — scan git-tracked files for secret-shaped filenames.
#
# Usage:
#   bin/scan-secrets                # human-readable table
#   bin/scan-secrets --json         # JSON array of finding stubs
#   bin/scan-secrets --strict       # exit 1 if any secret-shaped file is tracked
#   bin/scan-secrets --help         # this help
#
# Run from any project root. Uses `git ls-files` to enumerate tracked files,
# then matches against PATTERNS below. Each match becomes an auto-blocker
# finding (per the rubric: tracked secret = permanent compromise).

require 'json'
require 'open3'

# Pattern → severity. Severity is bumped to 'blocker' for high-confidence
# matches (private keys, service-account JSONs); 'high' for ambiguous ones
# (CSV files that *might* contain user data); 'medium' for catch-alls.
PATTERNS = [
  { pattern: /\.pem\z/i,                      severity: 'blocker', label: 'Private key file (.pem)' },
  { pattern: /google[-_]?cloud[-_]?credentials.*\.json\z/i, severity: 'blocker', label: 'Google Cloud credentials JSON' },
  { pattern: /firebase[-_]?admin.*\.json\z/i, severity: 'blocker', label: 'Firebase admin SDK JSON' },
  { pattern: /\baws[-_]?credentials\b/i,      severity: 'blocker', label: 'AWS credentials file' },
  { pattern: /service[-_]?account.*\.json\z/i,severity: 'blocker', label: 'GCP service account JSON' },
  { pattern: /\bgcp[-_]?key\.json\z/i,        severity: 'blocker', label: 'GCP key file' },
  { pattern: /\bcredentials\.txt\z/i,         severity: 'blocker', label: 'Generic credentials file' },
  { pattern: /\bsecrets?\.txt\z/i,            severity: 'blocker', label: 'Generic secrets file' },
  { pattern: /\.env\.production\z/i,          severity: 'blocker', label: 'Production .env file' },
  { pattern: /\.env\z/i,                      severity: 'high',    label: 'Generic .env file (may be local-only)' },
  { pattern: /\.env\.\w+\z/i,                 severity: 'high',    label: 'Per-env .env file' },
  { pattern: /\.p12\z/i,                      severity: 'blocker', label: 'PKCS#12 archive (.p12)' },
  { pattern: /\.pfx\z/i,                      severity: 'blocker', label: 'Windows certificate archive (.pfx)' },
  { pattern: /\.keystore\z/i,                 severity: 'blocker', label: 'Java keystore' },
  { pattern: /\bid_rsa\b/,                    severity: 'blocker', label: 'SSH private key (id_rsa)' },
  { pattern: /\bid_ed25519\b/,                severity: 'blocker', label: 'SSH private key (id_ed25519)' },
  { pattern: /\bcircle[-_]?wallets\.txt\z/i,  severity: 'high',    label: 'Crypto wallet file' },
  # CSVs are heuristic — flag if filename hints at PII, otherwise skip
  { pattern: /\b(users|members|customers|payments|recipients)\.csv\z/i, severity: 'high', label: 'Likely PII CSV' }
].freeze

# Files that match the patterns above but are KNOWN-SAFE. Don't flag these.
EXCLUSIONS = [
  /\.example\z/,        # *.env.example etc.
  /\.sample\z/,         # *.env.sample
  /\.template\z/,       # *.template
  /\.gitkeep\z/,
  /^spec\//,            # files in spec/ — fixtures, not real
  /^test\//,
  /^fixtures?\//,
  /\bexample[-_]/       # example-credentials.txt etc.
].freeze

CERT_EXTENSIONS = %w[.crt .cer .cert .ca .pub].freeze # Public — explicitly allowed

# ---------------------------------------------------------------------------

def git_tracked_files
  out, _err, status = Open3.capture3('git', 'ls-files')
  return [] unless status.success?
  out.lines.map(&:chomp)
end

def excluded?(path)
  EXCLUSIONS.any? { |re| path.match?(re) } || CERT_EXTENSIONS.any? { |ext| path.downcase.end_with?(ext) }
end

def scan(files)
  matches = []
  files.each do |path|
    next if excluded?(path)
    PATTERNS.each do |entry|
      next unless path.match?(entry[:pattern])
      matches << {
        file: path,
        severity: entry[:severity],
        label: entry[:label],
        pattern: entry[:pattern].source
      }
      break # one match per file is enough
    end
  end
  matches
end

# ---------------------------------------------------------------------------

def render_table(matches)
  if matches.empty?
    puts 'No tracked secret-shaped files found.'
    return
  end
  rows = matches.map { |m| [m[:severity].upcase, m[:label], m[:file]] }
  widths = [0, 1, 2].map do |i|
    [(['Severity', 'Label', 'File'][i]).length, *rows.map { |r| r[i].to_s.length }].max
  end
  fmt = widths.map { |w| "%-#{w}s" }.join('  ')
  puts(format(fmt, 'Severity', 'Label', 'File'))
  puts(widths.map { |w| '-' * w }.join('  '))
  rows.each { |r| puts(format(fmt, *r)) }
end

def render_json(matches)
  finding_stubs = matches.map.with_index do |m, idx|
    {
      id: "f-secret-#{format('%04d', idx + 1)}-#{m[:file].sum.to_s(16)[0..7]}",
      severity: m[:severity],
      primary_dimension: 'security-and-authz',
      secondary_dimensions: %w[data-governance deploy-and-ci],
      title: "Tracked secret in git: #{m[:label]}",
      location: { file: m[:file] },
      evidence: {
        snippet: "git ls-files matched: #{m[:file]} (pattern: /#{m[:pattern]}/)",
        normalized: "tracked_secret_#{m[:label].downcase.gsub(/\W+/, '_')}"
      },
      explanation: "#{m[:label]} is tracked in git history. ANY tracked secret should be considered permanently compromised — anyone with repo read access (current or historical) has the material. Even if removed from current HEAD, the file persists in commit history.",
      fix_sketch: "1) Rotate the credential. 2) `git rm --cached '#{m[:file]}'` and add to `.gitignore`. 3) Use `git-filter-repo` to rewrite history if exposure window matters. 4) Coordinate with team before force-push.",
      time_estimate: '1d',
      tool_origin: 'manual',
      phase: 1,
      ignored: false,
      self_check: { status: 'verified', notes: "git ls-files match for /#{m[:pattern]}/" }
    }
  end
  puts JSON.pretty_generate(finding_stubs)
end

# ---------------------------------------------------------------------------

def parse_args(argv)
  modes = []
  argv.each do |arg|
    case arg
    when '--json'   then modes << :json
    when '--strict' then modes << :strict
    when '-h', '--help' then modes << :help
    else
      warn "Unknown option: #{arg}"
      exit 2
    end
  end
  modes.empty? ? [:table] : modes
end

def show_help
  puts File.foreach(__FILE__).take(15).map { |l| l.sub(/^#\s?/, '') }.join
end

def main(argv)
  modes = parse_args(argv)
  return show_help if modes.include?(:help)

  files = git_tracked_files
  if files.empty?
    warn 'No git-tracked files found. Are you in a git repository?'
    exit 2
  end

  matches = scan(files)

  if modes.include?(:json)
    render_json(matches)
  else
    render_table(matches)
  end

  if modes.include?(:strict) && matches.any? { |m| %w[blocker high].include?(m[:severity]) }
    warn "\n#{matches.size} secret-shaped file(s) tracked in git. Rotate + untrack."
    exit 1
  end
end

main(ARGV) if __FILE__ == $PROGRAM_NAME
