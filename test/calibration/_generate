  doc['scorecards'] = scorecards(low_dims)
  doc['findings'] = [
    finding('c1d-b1', severity: 'blocker', dim_index: 0),
    finding('c1d-h1', severity: 'high',    dim_index: 1),
    finding('c1d-h2', severity: 'high',    dim_index: 2),
    finding('c1d-h3', severity: 'high',    dim_index: 3),
    finding('c1d-h4', severity: 'high',    dim_index: 4),
    finding('c1d-h5', severity: 'high',    dim_index: 5),
    finding('c1d-m1', severity: 'medium',  dim_index: 6),
    finding('c1d-m2', severity: 'medium',  dim_index: 7),
    finding('c1d-m3', severity: 'medium',  dim_index: 8),
    finding('c1d-m4', severity: 'medium',  dim_index: 9),
    finding('c1d-m5', severity: 'medium',  dim_index: 10),
    finding('c1d-m6', severity: 'medium',  dim_index: 11)
  ]
  doc['summary']['top_blocker_ids'] = [doc['findings'][0]['id']]
  write('c1-fires-c7-fails-dims', doc)
end

# 4. c2-fires — blocker over-use, no C7.
#    10 findings: 4 blockers (40%) + 1 high + 5 medium.
def gen_c2_fires
  doc = base('c2-fires')
  doc['summary']['risk_score'] = 5
  low_dims = ALL_DIMS.first(5).each_with_object({}) { |d, h| h[d] = 3 }
  doc['scorecards'] = scorecards(low_dims)
  doc['findings'] = [
    finding('c2-b1', severity: 'blocker', dim_index: 0),
    finding('c2-b2', severity: 'blocker', dim_index: 1),
    finding('c2-b3', severity: 'blocker', dim_index: 2),
    finding('c2-b4', severity: 'blocker', dim_index: 3),
    finding('c2-h1', severity: 'high',    dim_index: 4),
    finding('c2-m1', severity: 'medium',  dim_index: 5),
    finding('c2-m2', severity: 'medium',  dim_index: 6),
    finding('c2-m3', severity: 'medium',  dim_index: 7),
    finding('c2-m4', severity: 'medium',  dim_index: 8),
    finding('c2-m5', severity: 'medium',  dim_index: 9)
  ]
  doc['summary']['top_blocker_ids'] = doc['findings'].first(3).map { |f| f['id'] }
  write('c2-fires', doc)
end

# 5. c3-unverified-blocker — C3 fires, C7 cannot apply.
#    Same broad-decay shape as #2 but the blocker is unverified.
def gen_c3_unverified_blocker
  doc = base('c3-unverified-blocker')
  doc['summary']['risk_score'] = 4
  low_dims = ALL_DIMS.first(12).each_with_object({}) { |d, h| h[d] = 3 }
  doc['scorecards'] = scorecards(low_dims)
  doc['findings'] = [
    finding('c3-b1', severity: 'blocker', dim_index: 0, unverified: true),
    finding('c3-h1', severity: 'high',    dim_index: 1),
    finding('c3-h2', severity: 'high',    dim_index: 2),
    finding('c3-h3', severity: 'high',    dim_index: 3),
    finding('c3-h4', severity: 'high',    dim_index: 4),
    finding('c3-h5', severity: 'high',    dim_index: 5),
    finding('c3-m1', severity: 'medium',  dim_index: 6),
    finding('c3-m2', severity: 'medium',  dim_index: 7),
    finding('c3-m3', severity: 'medium',  dim_index: 8),
    finding('c3-m4', severity: 'medium',  dim_index: 9),
