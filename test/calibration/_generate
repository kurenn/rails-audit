# 6. c4-phase-mismatch — fix_sequence references finding with mismatched phase.
def gen_c4_phase_mismatch
  doc = base('c4-phase-mismatch')
  doc['summary']['risk_score'] = 7
  doc['scorecards'] = scorecards
  f1 = finding('c4-h1', severity: 'high',   phase: 1, dim_index: 0)
  f2 = finding('c4-m1', severity: 'medium', phase: 1, dim_index: 1)
  f3 = finding('c4-m2', severity: 'medium', phase: 2, dim_index: 2) # actually phase 2
  doc['findings'] = [f1, f2, f3]
  doc['fix_sequence'] = [
    { 'phase' => 1, 'name' => 'p1', 'estimated_effort' => '1d', 'rationale' => 'r',
      'finding_ids' => [f1['id'], f3['id']] }, # f3 is phase 2 in finding, but listed in phase 1 here
    { 'phase' => 2, 'name' => 'p2', 'estimated_effort' => '1d', 'rationale' => 'r',
      'finding_ids' => [f2['id']] } # f2 is phase 1 in finding, listed in phase 2 here
  ]
  write('c4-phase-mismatch', doc)
end

# 7. c5-scorecard-mismatch — one dimension scored 9 but has 6+ weighted findings;
# rest of the report is otherwise calibrated (no C1/C2/C3 noise).
# Findings: 1 blocker + 3 high all on `security-and-authz` (weighted 4+9 = 13)
# plus 6 medium on other dimensions to keep blocker_pct/high_pct under thresholds.
def gen_c5_scorecard_mismatch
  doc = base('c5-scorecard-mismatch')
  doc['summary']['risk_score'] = 6
  overrides = { 'security-and-authz' => 9 }
  doc['scorecards'] = scorecards(overrides)
  doc['findings'] = [
    finding('c5-b1', severity: 'blocker', dim: 'security-and-authz'),
    finding('c5-h1', severity: 'high',    dim: 'security-and-authz'),
    finding('c5-h2', severity: 'high',    dim: 'security-and-authz'),
    finding('c5-h3', severity: 'high',    dim: 'security-and-authz'),
    finding('c5-m1', severity: 'medium',  dim_index: 1),
    finding('c5-m2', severity: 'medium',  dim_index: 2),
    finding('c5-m3', severity: 'medium',  dim_index: 3),
    finding('c5-m4', severity: 'medium',  dim_index: 4),
    finding('c5-m5', severity: 'medium',  dim_index: 5),
    finding('c5-m6', severity: 'medium',  dim_index: 6),
    finding('c5-m7', severity: 'medium',  dim_index: 7)
  ]
  # 11 findings: 1 blocker (9.1%), 3 high (27.3%), 7 medium → no C1/C2 fires.
  # security-and-authz weighted = 4 + 3*3 = 13 → expected band 0–2;
  # actual score 9 → delta 7 > 2 → C5 fires on this single dimension.
  doc['summary']['top_blocker_ids'] = [doc['findings'][0]['id']]
  write('c5-scorecard-mismatch', doc)
end

# All five together (bin/run-self-check called with --coverage-mtime
# generates C6 in the test runner; no fixture file needed for that.)

gen_clean_baseline
gen_c1_fires_c7_suppresses
gen_c1_fires_c7_fails_dims
gen_c2_fires
gen_c3_unverified_blocker
gen_c4_phase_mismatch
gen_c5_scorecard_mismatch

puts 'done — 7 fixtures generated. C6 (stale coverage) is exercised at test time via --coverage-mtime.'
